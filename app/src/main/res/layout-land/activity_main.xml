<?xml version="1.0" encoding="utf-8"?>
<!--
  Landscape camera layout.
  Same resource ids as the portrait layout (view binding is generated from layout/),
  but the chrome moves out of the way: controls sit on the right edge for thumb reach,
  the mode strip above the bottom bar, and the loupe stays top-end.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ink"
    android:keepScreenOn="true"
    tools:context=".MainActivity">

    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:implementationMode="performance"
        app:scaleType="fillCenter"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.example.zoomhundred.overlay.ZebraView
        android:id="@+id/zebraView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/previewView"
        app:layout_constraintEnd_toEndOf="@id/previewView"
        app:layout_constraintStart_toStartOf="@id/previewView"
        app:layout_constraintTop_toTopOf="@id/previewView" />

    <com.example.zoomhundred.overlay.FalseColorView

        android:id="@+id/falseColorView"

        android:layout_width="0dp"

        android:layout_height="0dp"

        android:clickable="false"

        android:visibility="gone" />

    <com.example.zoomhundred.overlay.FocusPeakingView
        android:id="@+id/peakingView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/previewView"
        app:layout_constraintEnd_toEndOf="@id/previewView"
        app:layout_constraintStart_toStartOf="@id/previewView"
        app:layout_constraintTop_toTopOf="@id/previewView" />

    <com.example.zoomhundred.overlay.GridOverlayView
        android:id="@+id/gridOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@id/previewView"
        app:layout_constraintEnd_toEndOf="@id/previewView"
        app:layout_constraintStart_toStartOf="@id/previewView"
        app:layout_constraintTop_toTopOf="@id/previewView" />

    <com.example.zoomhundred.overlay.ExtremeZoomOverlayView
        android:id="@+id/extremeOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@id/previewView"
        app:layout_constraintEnd_toEndOf="@id/previewView"
        app:layout_constraintStart_toStartOf="@id/previewView"
        app:layout_constraintTop_toTopOf="@id/previewView" />

    <View
        android:id="@+id/focusRing"
        android:layout_width="76dp"
        android:layout_height="76dp"
        android:alpha="0"
        android:background="@drawable/focus_ring"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/previewView"
        app:layout_constraintEnd_toEndOf="@id/previewView"
        app:layout_constraintStart_toStartOf="@id/previewView"
        app:layout_constraintTop_toTopOf="@id/previewView" />

    <ImageView
        android:id="@+id/freezeScopeView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#F207080A"
        android:clickable="true"
        android:contentDescription="@string/freeze_scope"
        android:scaleType="fitCenter"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/previewView"
        app:layout_constraintEnd_toEndOf="@id/previewView"
        app:layout_constraintStart_toStartOf="@id/previewView"
        app:layout_constraintTop_toTopOf="@id/previewView" />

    <View
        android:id="@+id/nightOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#66000000"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/previewView"
        app:layout_constraintEnd_toEndOf="@id/previewView"
        app:layout_constraintStart_toStartOf="@id/previewView"
        app:layout_constraintTop_toTopOf="@id/previewView" />

    <View
        android:id="@+id/gestureLayer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clickable="true"
        app:layout_constraintBottom_toBottomOf="@id/previewView"
        app:layout_constraintEnd_toEndOf="@id/previewView"
        app:layout_constraintStart_toStartOf="@id/previewView"
        app:layout_constraintTop_toTopOf="@id/previewView" />

    <View
        android:id="@+id/edgeGlowLeft"
        android:layout_width="14dp"
        android:layout_height="0dp"
        android:background="@color/accent_dim"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/previewView"
        app:layout_constraintStart_toStartOf="@id/previewView"
        app:layout_constraintTop_toTopOf="@id/previewView" />

    <View
        android:id="@+id/edgeGlowRight"
        android:layout_width="14dp"
        android:layout_height="0dp"
        android:background="@color/accent_dim"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/previewView"
        app:layout_constraintEnd_toEndOf="@id/previewView"
        app:layout_constraintTop_toTopOf="@id/previewView" />

    <View
        android:id="@+id/edgeGlowTop"
        android:layout_width="0dp"
        android:layout_height="14dp"
        android:background="@color/accent_dim"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="@id/previewView"
        app:layout_constraintStart_toStartOf="@id/previewView"
        app:layout_constraintTop_toTopOf="@id/previewView" />

    <View
        android:id="@+id/edgeGlowBottom"
        android:layout_width="0dp"
        android:layout_height="14dp"
        android:background="@color/accent_dim"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/previewView"
        app:layout_constraintEnd_toEndOf="@id/previewView"
        app:layout_constraintStart_toStartOf="@id/previewView" />

    <LinearLayout
        android:id="@+id/topPanel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_scrim_top"
        android:gravity="center_vertical"
        android:minHeight="44dp"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="4dp"
        android:paddingEnd="10dp"
        android:paddingBottom="6dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/lensBadgeText"
            style="@style/Text.Micro"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:background="@drawable/bg_pill"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="@string/lens_loading"
            android:textColor="@color/text_primary" />

        <TextView
            android:id="@+id/proModeBadge"
            style="@style/Text.Micro"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_pill_accent"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="@string/pro_manual"
            android:textColor="@color/text_on_accent"
            android:visibility="gone" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/flashButton"
            style="@style/Widget.ZoomHundred.IconButtonSmall"
            android:contentDescription="@string/flash_off"
            android:src="@drawable/ic_flash_off" />

        <ImageView
            android:id="@+id/timerButton"
            style="@style/Widget.ZoomHundred.IconButtonSmall"
            android:layout_marginStart="6dp"
            android:contentDescription="@string/timer_off"
            android:src="@drawable/ic_timer" />

        <TextView
            android:id="@+id/hdrButton"
            style="@style/Text.Micro"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_chip_selector"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="@string/hrd_toggle"
            android:textColor="@color/text_primary" />

        <ImageView
            android:id="@+id/toolsButton"
            style="@style/Widget.ZoomHundred.IconButtonSmall"
            android:layout_marginStart="6dp"
            android:contentDescription="@string/tools"
            android:src="@drawable/ic_tune" />

        <ImageView
            android:id="@+id/settingsButton"
            style="@style/Widget.ZoomHundred.IconButtonSmall"
            android:layout_marginStart="6dp"
            android:contentDescription="@string/settings"
            android:src="@drawable/ic_settings" />
    </LinearLayout>

    <com.example.zoomhundred.overlay.LoupeView
        android:id="@+id/loupeView"
        android:layout_width="88dp"
        android:layout_height="88dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="14dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topPanel" />

    <LinearLayout
        android:id="@+id/sidePanel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topPanel">

        <ImageView
            android:id="@+id/gridButton"
            style="@style/Widget.ZoomHundred.IconButtonSmall"
            android:contentDescription="@string/grid"
            android:src="@drawable/ic_grid" />

        <ImageView
            android:id="@+id/loupeToggleButton"
            style="@style/Widget.ZoomHundred.IconButtonSmall"
            android:layout_marginStart="6dp"
            android:contentDescription="@string/loupe"
            android:src="@drawable/ic_loupe" />

        <ImageView
            android:id="@+id/monitorButton"
            style="@style/Widget.ZoomHundred.IconButtonSmall"
            android:layout_marginStart="6dp"
            android:contentDescription="@string/histogram"
            android:src="@drawable/ic_histogram" />
    </LinearLayout>

    <com.example.zoomhundred.overlay.HudView
        android:id="@+id/hudView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginTop="4dp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/sidePanel" />

    <com.example.zoomhundred.overlay.HistogramView
        android:id="@+id/histogramView"
        android:layout_width="104dp"
        android:layout_height="40dp"
        android:layout_marginStart="14dp"
        android:layout_marginBottom="4dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/levelView"
        app:layout_constraintStart_toStartOf="parent" />

    <com.example.zoomhundred.overlay.LevelIndicatorView
        android:id="@+id/levelView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/captureStatusText"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/captureStatusText"
        style="@style/Text.Readout"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:layout_marginBottom="4dp"
        android:background="@drawable/bg_pill"
        android:gravity="center"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/bottomControlsBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <LinearLayout
        android:id="@+id/shakeMeterRow"
        android:layout_width="180dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginBottom="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/captureStatusText"
        app:layout_constraintStart_toStartOf="parent">

        <com.example.zoomhundred.overlay.ShakeMeterView
            android:id="@+id/shakeMeter"
            android:layout_width="0dp"
            android:layout_height="6dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/shakeMeterLabel"
            style="@style/Text.Micro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/anti_shake_wait" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/bottomControlsBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_scrim_bottom"
        android:orientation="vertical"
        android:paddingTop="8dp"
        android:paddingBottom="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <HorizontalScrollView
            android:id="@+id/modeStripScroll"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:clipToPadding="false"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/modeStripContainer"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal">
            </LinearLayout>
        </HorizontalScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingEnd="18dp">

            <ImageView
                android:id="@+id/thumbnailView"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_thumbnail"
                android:contentDescription="@string/gallery"
                android:scaleType="centerCrop" />

            <TextView
                android:id="@+id/zoomValueText"
                style="@style/Text.Readout"
                android:layout_width="52dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:gravity="center_vertical"
                android:text="@string/default_zoom_ratio"
                android:textColor="@color/accent"
                android:textSize="13sp"
                android:textStyle="bold" />

            <com.example.zoomhundred.overlay.ZoomRailView
                android:id="@+id/zoomRail"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/zoomLockButton"
                style="@style/Widget.ZoomHundred.IconButtonSmall"
                android:layout_marginEnd="10dp"
                android:contentDescription="@string/zoom_lock"
                android:src="@drawable/ic_lock" />

            <com.example.zoomhundred.overlay.CaptureButtonView
                android:id="@+id/captureButton"
                android:layout_width="66dp"
                android:layout_height="66dp" />

            <FrameLayout
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_marginStart="12dp">

                <ImageView
                    android:id="@+id/switchCameraButton"
                    style="@style/Widget.ZoomHundred.IconButton"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:contentDescription="@string/camera_switch"
                    android:padding="11dp"
                    android:src="@drawable/ic_switch_camera" />

                <ImageView
                    android:id="@+id/pauseButton"
                    style="@style/Widget.ZoomHundred.IconButton"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:contentDescription="@string/record_pause"
                    android:padding="12dp"
                    android:src="@drawable/ic_pause"
                    android:visibility="gone" />
            </FrameLayout>

            <TextView
                android:id="@+id/recordTimerText"
                style="@style/Text.Readout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:textColor="@color/record_red"
                android:visibility="gone" />

            <TextView
                android:id="@+id/storageText"
                style="@style/Text.Micro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/bottomPanel"
        android:layout_width="320dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/bg_panel"
        android:orientation="vertical"
        android:padding="14dp"
        android:translationY="320dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/bottomControlsBar"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            style="@style/Text.Micro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/resize_bar" />

        <com.google.android.material.slider.Slider
            android:id="@+id/zoomSlider"
            style="@style/Widget.ZoomHundred.Slider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stepSize="0"
            android:value="0"
            android:valueFrom="0"
            android:valueTo="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/switchLensButton"
                style="@style/Widget.ZoomHundred.ControlButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="@string/lens" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/resetZoomButton"
                style="@style/Widget.ZoomHundred.ControlButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/zoom_reset" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/lockZoomButton"
                style="@style/Widget.ZoomHundred.ControlButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/zoom_lock" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/flashlightButton"
                style="@style/Widget.ZoomHundred.ControlButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="@string/flash_off" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/proSettingsButton"
                style="@style/Widget.ZoomHundred.ProButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/pro_settings" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/gestureHintOverlay"
        android:layout_width="280dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_panel"
        android:orientation="vertical"
        android:padding="14dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/bottomControlsBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            style="@style/Text.Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/gesture_hints"
            android:textStyle="bold" />

        <TextView
            style="@style/Text.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="@string/gesture_hint_body"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
